# ROBODU dashboard - konfigurasi Apache untuk hosting statis (Hostinger)
# File ini ikut ter-copy ke folder out/ saat `npm run build`.

# ---------------------------------------------------------------
# 1. Kompresi teks  -> memperbaiki "Document request latency"
# ---------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------
# 2. Cache  -> kunjungan berikutnya tidak mengunduh ulang
#    Aset di /_next/static/ namanya mengandung hash, jadi aman
#    di-cache selamanya. HTML tidak boleh di-cache lama supaya
#    hasil deploy baru langsung terlihat.
# ---------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

# ---------------------------------------------------------------
# 3. Redirect  -> satu lompatan saja, bukan rantai
#    http://www -> https:// langsung, tidak lewat http:// dulu.
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # /control  ->  /control.html  (hasil static export Next.js)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

ErrorDocument 404 /404.html
